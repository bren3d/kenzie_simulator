; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="hor"
run/main_scene="uid://bd31f2ihbhefp"
run/main_loop_type="Master"
config/features=PackedStringArray("4.5", "Forward Plus")
boot_splash/show_image=false
config/scene_transition_duration_sec=0.75

[audio]

buses/default_bus_layout="res://scripts/shaders/default_bus_layout.tres"

[autoload]

DialogueManager="*res://addons/dialogue_manager/dialogue_manager.gd"

[debug]

gdscript/warnings/unassigned_variable=0
gdscript/warnings/unused_variable=0
gdscript/warnings/unused_local_constant=0
gdscript/warnings/unused_private_class_variable=0
gdscript/warnings/unused_parameter=0
gdscript/warnings/unused_signal=0
gdscript/warnings/shadowed_variable=0
gdscript/warnings/unreachable_code=0
gdscript/warnings/standalone_expression=0
gdscript/warnings/standalone_ternary=0
gdscript/warnings/incompatible_ternary=0
gdscript/warnings/unsafe_void_return=0
gdscript/warnings/static_called_on_instance=0
gdscript/warnings/integer_division=0
gdscript/warnings/narrowing_conversion=0
gdscript/warnings/int_as_enum_without_cast=0
gdscript/warnings/int_as_enum_without_match=0
gdscript/warnings/enum_variable_without_default=0
gdscript/warnings/empty_file=0
gdscript/warnings/inference_on_variant=1

[dialogue_manager]

runtime/balloon_path="uid://dvw0futfnskdj"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/stretch/mode="viewport"
window/stretch/aspect="expand"

[editor]

movie_writer/movie_file="E:/Downloads/mov.avi"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogue_manager/plugin.cfg", "res://addons/stairs/plugin.cfg")

[file_customization]

folder_colors={
"res://addons/": "gray",
"res://assets/": "pink",
"res://autoload/": "teal",
"res://resources/": "gray",
"res://scenes/": "blue",
"res://script_templates/": "orange",
"res://scripts/": "yellow"
}

[gdscript]

warnings/unused_variable=0
warnings/unused_local_constant=0
warnings/unused_private_class_variable=0
warnings/unused_parameter=0
warnings/unused_signal=0
warnings/shadowed_variable=0
warnings/unreachable_code=0
warnings/standalone_expression=0
warnings/standalone_ternary=0
warnings/incompatible_ternary=0
warnings/unsafe_void_return=0
warnings/static_called_on_instance=0
warnings/integer_division=0
warnings/narrowing_conversion=0
warnings/int_as_enum_without_cast=0
warnings/int_as_enum_without_match=0
warnings/enum_variable_without_default=0
warnings/empty_file=0

[global_group]

Player=""

